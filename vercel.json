{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "settings.html", "use": "@vercel/static" },
    { "src": "toggle.html", "use": "@vercel/static" },
    { "src": "src/**", "use": "@vercel/static" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/settings/?$", "dest": "/settings.html" },
    { "src": "^/toggle/?$", "dest": "/toggle.html" },

    { "handle": "filesystem" },

    { "src": ".*", "dest": "/index.html" }
  ]
}
